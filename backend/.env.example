PORT=5000
BASE_URL=http://localhost:5000
# Optional; defaults to backend/data/urls.sqlite. Relative paths use the backend working directory.
# DATABASE_PATH=./data/urls.sqlite
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Leave blank to disable administration. Never use a VITE_ variable for this secret.
ADMIN_API_KEY=
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
CREATE_RATE_LIMIT_MAX=20
